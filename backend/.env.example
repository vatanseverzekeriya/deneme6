# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/metin2-rpg
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/metin2-rpg

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Game Configuration
MAX_PLAYERS_PER_MAP=50
POSITION_UPDATE_RATE=100
